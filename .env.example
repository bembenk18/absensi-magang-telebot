# ==========================================
# KONFIGURASI BOT ABSENSI TELEGRAM
# ==========================================

# 1. Masukkan Bot Token dari @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Lokasi Multi-Kantor (Bisa 2 kantor atau lebih)
# Kantor 1:
OFFICE_1_NAME=Kantor Blimbing
OFFICE_1_LAT=-7.641419237896039
OFFICE_1_LON=112.23067224112914
OFFICE_1_RADIUS=100

# Kantor 2:
OFFICE_2_NAME=Kantor Juanda
OFFICE_2_LAT=-7.546841554889875
OFFICE_2_LON=112.23001034241058
OFFICE_2_RADIUS=100

# 3. Zona Waktu (WIB: Asia/Jakarta, WITA: Asia/Makassar, WIT: Asia/Jayapura)
TIMEZONE=Asia/Jakarta

# 4. ID Telegram Admin (pisahkan dengan koma jika lebih dari 1)
ADMIN_IDS=123456789

# 5. Jam Buka Absen Pulang (Default: 17:00 WIB / jam 5 sore)
CHECKOUT_OPEN_HOUR=17
CHECKOUT_OPEN_MINUTE=0

# ==========================================
# 6. REKAP ABSENSI HARIAN OTOMATIS
# ==========================================
# Aktifkan pengiriman rekap absensi harian otomatis setelah jam pulang (true/false)
RECAP_ENABLED=true
# Jam & menit pengiriman rekap harian (default: 18:00 sesuai TIMEZONE)
RECAP_HOUR=18
RECAP_MINUTE=0
# Lewati pengiriman otomatis pada Sabtu & Minggu (true/false)
RECAP_SKIP_WEEKENDS=false
# Daftar ID Telegram penerima rekap (pisahkan koma). Jika kosong, otomatis memakai ADMIN_IDS
RECAP_RECIPIENT_IDS=
# Sertakan lampiran file CSV rekap harian saat pengiriman otomatis (true/false)
RECAP_SEND_CSV=false

# ==========================================
# 7. SINKRONISASI GOOGLE SHEETS & GOOGLE DRIVE
# ==========================================
# URL Webhook dari Google Apps Script (Deploy > Web app)
# Contoh: GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SHEET_WEBHOOK_URL=
# Shared secret untuk tanda tangan HMAC-SHA256 webhook (harus sama dengan Script Property WEBHOOK_SECRET di Apps Script)
GOOGLE_SHEET_WEBHOOK_SECRET=
